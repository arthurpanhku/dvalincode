{
  "name": "dvalincode-vscode",
  "displayName": "Dvalin Security Scan",
  "description": "Security findings from Dvalin in the Problems panel, with a governed fix-and-verify action. No API key needed to scan.",
  "version": "0.18.0",
  "publisher": "arthurpanhku",
  "license": "MIT",
  "homepage": "https://dvalincode.dev",
  "bugs": {
    "url": "https://github.com/arthurpanhku/dvalincode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arthurpanhku/dvalincode.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "security",
    "sast",
    "scan",
    "sarif",
    "audit"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1a237e",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dvalin.scan",
        "title": "Dvalin: Scan workspace"
      },
      {
        "command": "dvalin.clear",
        "title": "Dvalin: Clear findings"
      },
      {
        "command": "dvalin.setup",
        "title": "Dvalin: Set up with npx"
      },
      {
        "command": "dvalin.showVerification",
        "title": "Dvalin: Show last verification"
      },
      {
        "command": "dvalin.verifyFixRecord",
        "title": "Dvalin: Verify Fix Record offline"
      }
    ],
    "configuration": {
      "title": "Dvalin",
      "properties": {
        "dvalin.command": {
          "type": "string",
          "default": "dvalincode",
          "markdownDescription": "Command that runs the Dvalin CLI. Use `npx -y dvalincode` to run without installing."
        },
        "dvalin.scanners": {
          "type": "string",
          "default": "builtin",
          "markdownDescription": "Comma-separated scanners. Only `builtin` runs with no extra setup; `semgrep`, `trivy`, and `osv-scanner` are used when already on `PATH`."
        },
        "dvalin.scanScope": {
          "type": "string",
          "enum": [
            "changed",
            "workspace"
          ],
          "enumDescriptions": [
            "Only lines changed since the last commit, including new files. Fast, and reports what you just wrote.",
            "The entire workspace, including findings that were already there."
          ],
          "default": "changed",
          "markdownDescription": "What each scan reads. `changed` needs the folder to be a git repository; outside one, use `workspace`."
        },
        "dvalin.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Re-scan the workspace when a file is saved."
        },
        "dvalin.timeoutSeconds": {
          "type": "number",
          "default": 60,
          "description": "Abandon a scan that takes longer than this."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "package": "vsce package --no-dependencies --out dvalin-security-scan.vsix",
    "publish:vsce": "vsce publish --no-dependencies --packagePath dvalin-security-scan.vsix",
    "publish:ovsx": "ovsx publish dvalin-security-scan.vsix"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.0",
    "ovsx": "^0.10.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
